{
  "name": "recipies-service",
  "version": "1.0.0",
  "description": "APIs for recipe management",
  "author": {
    "name": "Erik Hage",
    "email": "ehage4@gmail.com"
  },
  "private": true,
  "scripts": {
    "start": "node ./bin/server",
    "lint": "eslint lib spec",
    "lint-fix": "eslint --fix lib spec",
    "test-unit": "mocha --require spec/helpers/init \"spec/unit/**/*.spec.js\"",
    "test-int": "mocha --require spec/helpers/integration/init \"spec/integration/**/*.spec.js\"",
    "coverage": "nyc --reporter=json-summary mocha --require spec/helpers/init \"spec/unit/**/*.spec.js\"",
    "coverage-check": "nyc --reporter=text-summary mocha --require spec/helpers/init \"spec/unit/**/*.spec.js\"",
    "coverage-update": "node bin/update-coverage.js",
    "prepush": "npm run lint && npm run coverage"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.1",
    "body-parser": "^1.20.8",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "errr": "^5.2.0",
    "express": "^4.22.3",
    "joi": "^18.2.9",
    "winston": "^2.4.4"
  },
  "devDependencies": {
    "chai": "^4.2.0",
    "dirty-chai": "^2.0.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^3.0.9",
    "mocha": "^12.0.2",
    "nock": "^14.0.17",
    "nyc": "^18.0.0",
    "sinon": "^7.5.0",
    "sinon-chai": "^3.3.0",
    "supertest": "^7.2.2"
  }
}
